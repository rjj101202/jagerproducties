# Kopieer dit bestand naar .env.local en vul de waardes in.
# Op Vercel zet je dezelfde variabelen bij Project → Settings → Environment Variables.

# Postgres-verbinding (Neon via Vercel Marketplace vult dit automatisch)
DATABASE_URL=

# API-key van resend.com (domein jagerproducties.nl eerst verifiëren)
RESEND_API_KEY=

# Wachtwoord voor jagerproducties.nl/admin — kies iets langs en unieks
ADMIN_PASSWORD=
